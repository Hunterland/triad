datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  STAFF
  ATHLETE
}

enum StaffRole {
  JUDGE
  MC
  DJ
  ORGANIZER
  STAFF_SUPPORT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BracketType {
  TOP8
  TOP16
}

enum BattlePhase {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

enum BattleStatus {
  PENDING
  ONGOING
  FINISHED
}

enum BattleSide {
  RED
  BLUE
}

enum RoundStatus {
  PENDING
  ONGOING
  FINISHED
}

enum JudgeScorecardStatus {
  DRAFT
  SUBMITTED
}

enum JudgingInterfaceType {
  LEVEL_A
  LEVEL_B
  TRIAD
  CUSTOM
}

enum JudgingConfigurationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JudgingPurpose {
  BATTLE
  PRESELECTION
}

// --------------------------------------------------
// USER AND AUTHORIZATION
// --------------------------------------------------

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String
  displayName String?
  isActive    Boolean @default(true)

  roles   UserRole[]
  athlete Athlete?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

// --------------------------------------------------
// EVENTS
// --------------------------------------------------

model Event {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)

  staffAssignments EventStaff[]
  categories       Category[]
  participants     EventParticipant[]
  brackets         Bracket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffMember {
  id          String    @id @default(uuid())
  name        String
  stageName   String?
  email       String?   @unique
  phone       String?
  country     String?
  city        String?
  documentId  String?
  defaultRole StaffRole
  specialty   String?
  isActive    Boolean   @default(true)

  eventAssignments EventStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_members")
}

model EventStaff {
  id            String    @id @default(uuid())
  eventId       String
  staffMemberId String
  role          StaffRole
  area          String?
  order         Int?
  isLead        Boolean   @default(false)
  isActive      Boolean   @default(true)

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMember      StaffMember       @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  judgeAssignments JudgeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, staffMemberId, role])
  @@index([eventId])
  @@index([staffMemberId])
  @@index([role])
  @@map("event_staff")
}

// --------------------------------------------------
// CATEGORIES
// --------------------------------------------------

model Category {
  id          String  @id @default(uuid())
  eventId     String
  name        String
  slug        String
  description String?
  rules       String?
  minAge      Int?
  maxAge      Int?
  level       String?
  isTeam      Boolean @default(false)
  isActive    Boolean @default(true)

  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations         EventParticipant[]
  brackets              Bracket[]
  judgeAssignments      JudgeAssignment[]
  judgingConfigurations JudgingConfiguration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@unique([eventId, slug])
  @@index([eventId])
}

// --------------------------------------------------
// ATHLETES
// --------------------------------------------------

model Athlete {
  id        String    @id @default(uuid())
  userId    String?   @unique
  name      String
  stageName String?
  email     String?   @unique
  phone     String?
  country   String?
  city      String?
  birthDate DateTime?
  isActive  Boolean   @default(true)

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  crews         CrewMember[]
  registrations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------
// CREWS
// --------------------------------------------------

model Crew {
  id       String  @id @default(uuid())
  name     String  @unique
  city     String?
  country  String?
  isActive Boolean @default(true)

  members       CrewMember[]
  registrations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CrewMember {
  crewId    String
  athleteId String
  role      String?

  crew    Crew    @relation(fields: [crewId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([crewId, athleteId])
  @@index([athleteId])
  @@index([crewId])
}

// --------------------------------------------------
// EVENT PARTICIPANTS / REGISTRATIONS
// --------------------------------------------------

model EventParticipant {
  id         String             @id @default(uuid())
  eventId    String
  categoryId String
  athleteId  String
  crewId     String?
  status     RegistrationStatus @default(PENDING)
  isActive   Boolean            @default(true)

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  athlete           Athlete            @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  crew              Crew?              @relation(fields: [crewId], references: [id], onDelete: SetNull)
  battleCompetitors BattleCompetitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, categoryId, athleteId])
  @@index([eventId])
  @@index([categoryId])
  @@index([athleteId])
  @@index([status])
  @@index([eventId, status])
}

// --------------------------------------------------
// BRACKETS
// --------------------------------------------------

model Bracket {
  id         String      @id @default(uuid())
  eventId    String
  categoryId String
  type       BracketType
  name       String
  isActive   Boolean     @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  battles  Battle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, categoryId, type])
  @@index([eventId])
  @@index([categoryId])
}

// --------------------------------------------------
// BATTLES
// --------------------------------------------------

model Battle {
  id        String       @id @default(uuid())
  bracketId String
  phase     BattlePhase
  order     Int
  status    BattleStatus @default(PENDING)
  isActive  Boolean      @default(true)

  bracket     Bracket            @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  rounds      Round[]
  competitors BattleCompetitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bracketId])
  @@index([phase])
}

// --------------------------------------------------
// BATTLE COMPETITORS
// --------------------------------------------------

model BattleCompetitor {
  id                 String     @id @default(uuid())
  battleId           String
  eventParticipantId String
  side               BattleSide
  isActive           Boolean    @default(true)

  battle           Battle                @relation(fields: [battleId], references: [id], onDelete: Cascade)
  eventParticipant EventParticipant      @relation(fields: [eventParticipantId], references: [id], onDelete: Restrict)
  criterionScores  JudgeCriterionScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([battleId, side])
  @@unique([battleId, eventParticipantId])
  @@index([battleId])
  @@index([eventParticipantId])
  @@map("battle_competitors")
}

// --------------------------------------------------
// ROUNDS
// --------------------------------------------------

model Round {
  id       String      @id @default(uuid())
  battleId String
  order    Int
  status   RoundStatus @default(PENDING)
  isActive Boolean     @default(true)

  battle          Battle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  judgeScorecards JudgeScorecard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([battleId, order])
  @@index([battleId])
  @@index([status])
}

// --------------------------------------------------
// JUDGE ASSIGNMENTS
// --------------------------------------------------

model JudgeAssignment {
  id           String  @id @default(uuid())
  eventStaffId String
  categoryId   String
  isActive     Boolean @default(true)

  eventStaff      EventStaff       @relation(fields: [eventStaffId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  judgeScorecards JudgeScorecard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventStaffId, categoryId])
  @@index([eventStaffId])
  @@index([categoryId])
  @@map("judge_assignments")
}

// --------------------------------------------------
// JUDGING CONFIGURATIONS
// --------------------------------------------------

model JudgingConfiguration {
  id            String                     @id @default(uuid())
  categoryId    String
  name          String
  interfaceType JudgingInterfaceType
  purpose       JudgingPurpose             @default(BATTLE)
  status        JudgingConfigurationStatus @default(DRAFT)
  version       Int                        @default(1)
  isActive      Boolean                    @default(true)

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  criteria        JudgeCriterion[]
  judgeScorecards JudgeScorecard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, purpose, version])
  @@index([categoryId, purpose])
  @@index([status])
  @@map("judging_configurations")
}

// --------------------------------------------------
// JUDGE CRITERIA
// --------------------------------------------------

model JudgeCriterion {
  id                     String  @id @default(uuid())
  judgingConfigurationId String
  code                   String
  name                   String
  description            String?
  weight                 Decimal @db.Decimal(5, 2)
  order                  Int
  minScore               Decimal @default(0) @db.Decimal(5, 2)
  maxScore               Decimal @default(10) @db.Decimal(5, 2)
  isActive               Boolean @default(true)

  judgingConfiguration JudgingConfiguration  @relation(fields: [judgingConfigurationId], references: [id], onDelete: Cascade)
  criterionScores      JudgeCriterionScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([judgingConfigurationId, code])
  @@unique([judgingConfigurationId, order])
  @@index([judgingConfigurationId])
  @@map("judge_criteria")
}

// --------------------------------------------------
// JUDGE SCORECARDS
// --------------------------------------------------

model JudgeScorecard {
  id                     String               @id @default(uuid())
  judgeAssignmentId      String
  roundId                String
  judgingConfigurationId String
  status                 JudgeScorecardStatus @default(DRAFT)
  submittedAt            DateTime?
  isActive               Boolean              @default(true)

  judgeAssignment      JudgeAssignment       @relation(fields: [judgeAssignmentId], references: [id], onDelete: Restrict)
  round                Round                 @relation(fields: [roundId], references: [id], onDelete: Restrict)
  judgingConfiguration JudgingConfiguration  @relation(fields: [judgingConfigurationId], references: [id], onDelete: Restrict)
  criterionScores      JudgeCriterionScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([judgeAssignmentId, roundId])
  @@index([judgeAssignmentId])
  @@index([roundId])
  @@index([judgingConfigurationId])
  @@index([status])
  @@map("judge_scorecards")
}

// --------------------------------------------------
// JUDGE CRITERION SCORES
// --------------------------------------------------

model JudgeCriterionScore {
  id                 String  @id @default(uuid())
  judgeScorecardId   String
  battleCompetitorId String
  judgeCriterionId   String
  score              Decimal @db.Decimal(5, 2)

  judgeScorecard   JudgeScorecard   @relation(fields: [judgeScorecardId], references: [id], onDelete: Cascade)
  battleCompetitor BattleCompetitor @relation(fields: [battleCompetitorId], references: [id], onDelete: Restrict)
  judgeCriterion   JudgeCriterion   @relation(fields: [judgeCriterionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([judgeScorecardId, battleCompetitorId, judgeCriterionId])
  @@index([judgeScorecardId])
  @@index([battleCompetitorId])
  @@index([judgeCriterionId])
  @@map("judge_criterion_scores")
}

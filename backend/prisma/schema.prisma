datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  STAFF
  ATHLETE
}

enum StaffRole {
  JUDGE
  MC
  DJ
  ORGANIZER
  STAFF_SUPPORT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BracketType {
  TOP8
  TOP16
}

enum BattlePhase {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

enum BattleStatus {
  PENDING
  ONGOING
  FINISHED
}

// --------------------------------------------------
// MODELS
// --------------------------------------------------

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String
  displayName String?
  isActive    Boolean @default(true)

  roles   UserRole[]
  athlete Athlete?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model Event {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)

  staffAssignments EventStaff[]
  categories       Category[]
  participants     EventParticipant[]
  brackets         Bracket[] // chaves do evento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffMember {
  id          String    @id @default(uuid())
  name        String
  stageName   String?
  email       String?   @unique
  phone       String?
  country     String?
  city        String?
  documentId  String?
  defaultRole StaffRole
  specialty   String?
  isActive    Boolean   @default(true)

  eventAssignments EventStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_members")
}

model EventStaff {
  id            String    @id @default(uuid())
  eventId       String
  staffMemberId String
  role          StaffRole
  area          String?
  order         Int?
  isLead        Boolean   @default(false)
  isActive      Boolean   @default(true)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, staffMemberId, role])
  @@index([eventId])
  @@index([staffMemberId])
  @@index([role])
  @@map("event_staff")
}

// --------------------------------------------------
// CATEGORY
// --------------------------------------------------

model Category {
  id          String  @id @default(uuid())
  eventId     String
  name        String
  slug        String
  description String?
  rules       String?
  minAge      Int?
  maxAge      Int?
  level       String?
  isTeam      Boolean @default(false)
  isActive    Boolean @default(true)

  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventParticipant[]
  brackets      Bracket[] // chaves por categoria

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
  @@unique([eventId, slug])
  @@index([eventId])
}

// --------------------------------------------------
// ATHLETE
// --------------------------------------------------

model Athlete {
  id        String    @id @default(uuid())
  userId    String?   @unique
  name      String
  stageName String?
  email     String?   @unique
  phone     String?
  country   String?
  city      String?
  birthDate DateTime?
  isActive  Boolean   @default(true)

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  crews         CrewMember[]
  registrations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------
// CREW
// --------------------------------------------------

model Crew {
  id       String  @id @default(uuid())
  name     String  @unique
  city     String?
  country  String?
  isActive Boolean @default(true)

  members       CrewMember[]
  registrations EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------
// CREW MEMBER (pivot)
// --------------------------------------------------

model CrewMember {
  crewId    String
  athleteId String
  role      String?

  crew    Crew    @relation(fields: [crewId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([crewId, athleteId])
  @@index([athleteId])
  @@index([crewId])
}

// --------------------------------------------------
// EVENT PARTICIPANT / REGISTRATION
// --------------------------------------------------

model EventParticipant {
  id         String             @id @default(uuid())
  eventId    String
  categoryId String
  athleteId  String
  crewId     String?
  status     RegistrationStatus @default(PENDING)
  isActive   Boolean            @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  athlete  Athlete  @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  crew     Crew?    @relation(fields: [crewId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, categoryId, athleteId])
  @@index([eventId])
  @@index([categoryId])
  @@index([athleteId])
  @@index([status])
  @@index([eventId, status])
}

// --------------------------------------------------
// BRACKETS
// --------------------------------------------------

model Bracket {
  id         String      @id @default(uuid())
  eventId    String
  categoryId String
  type       BracketType // TOP8 ou TOP16
  name       String
  isActive   Boolean     @default(true)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  battles  Battle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um tipo de chave por evento+categoria (v1)
  @@unique([eventId, categoryId, type])
  @@index([eventId])
  @@index([categoryId])
}

// --------------------------------------------------
// BATTLES
// --------------------------------------------------

model Battle {
  id        String       @id @default(uuid())
  bracketId String
  phase     BattlePhase // ROUND_OF_16, QUARTER_FINAL, SEMI_FINAL, FINAL
  order     Int // posição dentro da fase (1..N)
  status    BattleStatus @default(PENDING) // PENDING, ONGOING, FINISHED
  isActive  Boolean      @default(true)

  bracket Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bracketId])
  @@index([phase])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  STAFF
  ATHLETE
}

// --------------------------------------------------
// MODELS
// --------------------------------------------------

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String // hash (bcrypt) será armazenado aqui
  displayName String?
  isActive    Boolean @default(true)

  roles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId]) // um user não pode ter o mesmo role duas vezes
}

model Event {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

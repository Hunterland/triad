datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum RoleName {
  ADMIN
  ORGANIZER
  JUDGE
  STAFF
  ATHLETE
}

enum StaffRole {
  JUDGE
  MC
  DJ
  ORGANIZER
  STAFF_SUPPORT
}

// --------------------------------------------------
// MODELS
// --------------------------------------------------

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  password    String // hash (bcrypt) será armazenado aqui
  displayName String?
  isActive    Boolean @default(true)

  roles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id    String     @id @default(uuid())
  name  RoleName   @unique
  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId]) // um user não pode ter o mesmo role duas vezes
}

model Event {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)

  staffAssignments EventStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffMember {
  id          String    @id @default(uuid())
  name        String
  stageName   String?
  email       String?   @unique
  phone       String?
  country     String?
  city        String?
  documentId  String?
  defaultRole StaffRole
  specialty   String?
  isActive    Boolean   @default(true)

  eventAssignments EventStaff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_members")
}

model EventStaff {
  id            String    @id @default(uuid())
  eventId       String
  staffMemberId String
  role          StaffRole
  area          String?
  order         Int?
  isLead        Boolean   @default(false)
  isActive      Boolean   @default(true)

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, staffMemberId, role])
  @@index([eventId])
  @@index([staffMemberId])
  @@index([role])
  @@map("event_staff")
}
